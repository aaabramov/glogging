<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.aaabramov</groupId>
    <artifactId>glogging</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>glogging</name>
    <description>Logback layout for Google Structured logging</description>
    <url>https://github.com/aaabramov/glogging</url>

    <organization>
        <url>https://github.com/aaabramov</url>
        <name>Andrii Abramov</name>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Andrii Abramov</name>
            <organizationUrl>https://github.com/aaabramov</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/aaabramov/glogging</connection>
        <developerConnection>scm:git:https://github.com/aaabramov/glogging</developerConnection>
        <url>https://github.com/aaabramov/glogging</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>Github</system>
        <url>https://github.com/aaabramov/glogging/issues</url>
    </issueManagement>

    <ciManagement>
        <system>Github Actions</system>
        <url>https://github.com/aaabramov/glogging/actions</url>
    </ciManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <!-- 5.11.x is the last JUnit line with a Java 8 baseline (6.x requires Java 17). -->
        <version.junit>5.14.4</version.junit>
    </properties>

    <modules>
        <module>core</module>
        <module>gson</module>
        <module>jackson</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${version.junit}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Attaching source jar (required by Maven Central) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <!-- Attaching javadoc jar (required by Maven Central) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                </plugin>
                <!-- GPG signing (required by Maven Central) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.7</version>
                </plugin>
                <!-- Publishing to the Sonatype Central Portal (replaces the
                     retired OSSRH / nexus-staging flow, EOL 2025-06-30). -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <!--
                        Keep this current. The Portal API adds response fields over
                        time and the plugin deserializes them strictly, so an old
                        plugin fails *after* the bundle has already been accepted:
                        0.7.0 died on Unrecognized field "warnings", which 0.11.0
                        added to DeploymentApiResponse.
                    -->
                    <version>0.11.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            Release profile: activate with `mvn -Prelease deploy`.
            Kept out of the default build so ordinary CI `mvn package` runs
            stay fast and do not require a GPG key. Publishes to the Sonatype
            Central Portal (https://central.sonatype.com) — the OSSRH / Nexus
            staging flow was retired 2025-06-30.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!--
                                Tag pushes publish straight through, no manual step.

                                To rehearse a risky release instead - a new signing
                                key, a big dependency jump - set autoPublish=false and
                                waitUntil=validated. The bundle is then uploaded,
                                signed and validated, but parked in the Portal awaiting
                                a manual Publish, so it can still be dropped. Worth
                                doing because a published version is permanent: Central
                                never allows it to be deleted or overwritten.
                            -->
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
