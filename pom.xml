<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.aaabramov</groupId>
    <artifactId>glogging</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>glogging</name>
    <description>Logback layout for Google Structured logging</description>
    <url>https://github.com/aaabramov/glogging</url>

    <organization>
        <url>https://github.com/aaabramov</url>
        <name>Andrii Abramov</name>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Andrii Abramov</name>
            <organizationUrl>https://github.com/aaabramov</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/aaabramov/glogging</connection>
        <developerConnection>scm:git:https://github.com/aaabramov/glogging</developerConnection>
        <url>https://github.com/aaabramov/glogging</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>Github</system>
        <url>https://github.com/aaabramov/glogging/issues</url>
    </issueManagement>

    <ciManagement>
        <system>Github Actions</system>
        <url>https://github.com/aaabramov/glogging/actions</url>
    </ciManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            The Java 8 baseline. These two are only the fallback for building ON
            JDK 8, which has no `release` compiler option; every newer JDK takes
            the `maven.compiler.release` route in the jdk9plus profile below, and
            `release` wins over these when both are set.

            Why that matters: `-source` and `-target` set the bytecode level but
            still compile against the *running* JDK's class library, so calling
            an API that does not exist on Java 8 compiles cleanly, produces a
            class file stamped major 52, and then throws NoSuchMethodError on a
            real Java 8 JVM. javac says so itself - "not setting the bootstrap
            class path may lead to class files that cannot run on JDK 8". The
            `release` option sets the bootstrap class path, so the same code is
            rejected at compile time instead.
        -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <!--
            Makes the build reproducible: fixes every archive entry's timestamp
            instead of stamping "now", so the same source tree yields
            byte-identical jars. Recommended for Maven Central publication.
            https://maven.apache.org/guides/mini/guide-reproducible-builds.html

            Deliberately a constant, not ${maven.build.timestamp} - a moving
            value would defeat the point. Bump it by hand when cutting a
            release if you want it to reflect that release's date; the value
            only has to be stable, it does not have to be accurate.
        -->
        <project.build.outputTimestamp>2026-08-03T00:00:00Z</project.build.outputTimestamp>
        <!-- Stay on 5.x: it keeps a Java 8 baseline, while 6.x requires Java 17.
             Dependabot ignores majors here for that reason. -->
        <version.junit>5.14.4</version.junit>
        <!--
            Shared by all three modules: core compiles against it (provided), and
            gson/jackson need it at test scope for their demo apps - `provided` is
            not transitive, so they cannot inherit it from core.

            This is the version glogging is built and tested against, NOT a version
            imposed on consumers; they declare their own. 1.3.x is the last line
            supporting Java 8, and Dependabot is configured to ignore minors and
            majors here for that reason.
        -->
        <version.logback>1.3.16</version.logback>
    </properties>

    <modules>
        <module>core</module>
        <module>gson</module>
        <module>jackson</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${version.junit}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Pinned (rather than inherited from the super-POM) so the
                    build does not change shape with the Maven version, and so
                    Dependabot tracks it. Each module sets its own
                    Automatic-Module-Name through this plugin.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <!-- Attaching source jar (required by Maven Central) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <!-- Attaching javadoc jar (required by Maven Central) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <!-- GPG signing (required by Maven Central) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <!-- Publishing to the Sonatype Central Portal (replaces the
                     retired OSSRH / nexus-staging flow, EOL 2025-06-30). -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <!--
                        Keep this current. The Portal API adds response fields over
                        time and the plugin deserializes them strictly, so an old
                        plugin fails *after* the bundle has already been accepted:
                        0.7.0 died on Unrecognized field "warnings", which 0.11.0
                        added to DeploymentApiResponse.
                    -->
                    <version>0.11.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                Inherited by every module; each one supplies its own
                ${module.name}. Configured once here rather than three times to
                keep the modules from drifting apart.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Compile against the Java 8 *class library*, not merely down to Java 8
            bytecode. See the note on maven.compiler.source above for what
            -source and -target alone fail to catch.

            Conditional on the JDK because the `release` option arrived in JDK 9,
            so passing it on the JDK 8 matrix leg would fail the build outright.
            That leg needs no protection anyway: its class library IS Java 8.
            Once the baseline moves off 8 (see IMPROVEMENTS decision 0.1) this
            profile collapses into a plain maven.compiler.release property.

            Verified by mutation, not by reading: adding a `String.isBlank()`
            call (Java 11) to core makes `mvn verify` fail on JDK 9+ with
            "cannot find symbol", where it compiled silently before this change.
        -->
        <profile>
            <id>jdk9plus</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
        </profile>

        <!--
            Release profile: activate with `mvn -Prelease deploy`.
            Kept out of the default build so ordinary CI `mvn package` runs
            stay fast and do not require a GPG key. Publishes to the Sonatype
            Central Portal (https://central.sonatype.com) — the OSSRH / Nexus
            staging flow was retired 2025-06-30.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!--
                                Tag pushes publish straight through, no manual step.

                                To rehearse a risky release instead - a new signing
                                key, a big dependency jump - set autoPublish=false and
                                waitUntil=validated. The bundle is then uploaded,
                                signed and validated, but parked in the Portal awaiting
                                a manual Publish, so it can still be dropped. Worth
                                doing because a published version is permanent: Central
                                never allows it to be deleted or overwritten.
                            -->
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
