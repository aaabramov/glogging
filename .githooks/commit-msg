#!/bin/sh
#
# Rejects AI-tooling attribution in commit messages.
#
# Git history here is authored by a person; which editor or assistant helped
# write a patch is not part of the record, and on a public repository it is
# permanent and visible to everyone. Claude Code emits a `Claude-Session:`
# trailer by default, so this is a belt-and-braces check rather than the
# primary defence — the setting that turns it off at the source is
# `attribution.sessionUrl: false` in ~/.claude/settings.json (alongside
# `attribution.commit` and `attribution.pr`, which are separate fields).
#
# Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# Bypass for a single commit, if you ever genuinely need to:
#
#     git commit --no-verify
#
set -eu

msg_file="$1"

# Strip comment lines so a commented-out example never trips the check.
subject_and_body=$(grep -v '^#' "$msg_file" || true)

matches=$(printf '%s\n' "$subject_and_body" | grep -n -i -E \
    'Claude-Session:|Co-Authored-By:[[:space:]]*Claude|Generated with[[:space:]]+.*Claude|noreply@anthropic\.com' || true)

if [ -n "$matches" ]; then
    printf '%s\n' "commit-msg: refusing to commit AI attribution." >&2
    printf '%s\n' "" >&2
    printf '%s\n' "$matches" | sed 's/^/  /' >&2
    printf '%s\n' "" >&2
    printf '%s\n' "Remove the line(s) above and commit again." >&2
    printf '%s\n' "Turn it off at the source with attribution.sessionUrl=false in" >&2
    printf '%s\n' "~/.claude/settings.json. To bypass once: git commit --no-verify" >&2
    exit 1
fi
